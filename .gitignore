# .gitignore for cfs_cnn_age

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/
*.egg
*.whl

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Mypy
.mypy_cache/

# Jupyter
.ipynb_checkpoints

# VSCode / IDE
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS generated
.DS_Store
Thumbs.db

# Local env files
.env
.env.*
*.env

# Logs
*.log

# ignore dirs
input/
output/

# ignore default model
defaults/default_model.pt

# but keep these
!input/README.md
!output/README.md

# Temporary docs and exported images (optional)
docs/_build/
*.png
*.svg

# Other
*.zip
*.tar.gz
